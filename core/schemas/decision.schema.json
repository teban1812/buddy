{
  "$comment": "Front matter of an architecture decision record in MADR 4, docs/decisions/<id>-<slug>.md: MADR's own fields (status, date, decision-makers, consulted, informed) and Buddy's. The body holds the MADR sections. Records written before MADR 4 (no decision-makers, status superseded without its successor, in a change folder) still read.",
  "type": "object",
  "required": ["schema", "id", "date", "title", "status", "requested_by", "decided_by", "rules"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "buddy/decision@0" },
    "id": { "type": "string", "pattern": "^D-\\d{4}-\\d{2}-\\d{2}-[0-9a-f]{4}$" },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "title": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "pattern": "^(in-progress|accepted|superseded|superseded by D-\\d{4}-\\d{2}-\\d{2}-[0-9a-f]{4})$" },
    "decision-makers": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "consulted": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "informed": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "built": { "enum": ["built", "partly", "not built", "backlog", "deferred", "superseded", "not applicable"] },
    "where": { "type": "string", "minLength": 1 },
    "requested_by": { "type": "string", "minLength": 1 },
    "decided_by": { "enum": ["human", "agent"] },
    "slice": { "type": "string", "pattern": "^(?=.{1,40}$)[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "supersedes": { "type": "array", "items": { "type": "string", "pattern": "^D-\\d{4}-\\d{2}-\\d{2}-[0-9a-f]{4}$" } },
    "questions": { "type": "array", "items": { "type": "string", "pattern": "^Q-\\d{4}-\\d{2}-\\d{2}-[0-9a-f]{4}$" } },
    "evidence": { "type": "string" },
    "rules": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["text", "origin"],
        "additionalProperties": false,
        "properties": {
          "text": { "type": "string", "minLength": 1 },
          "origin": { "enum": ["human", "delegated", "agent", "assumed", "repo"] },
          "confidence": { "enum": ["high", "medium", "low"] },
          "cite": { "type": "string" }
        }
      }
    }
  }
}
